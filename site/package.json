{
  "name": "dcs-world-reference-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "tsx scripts/copy-sqlite-assets.ts && tsx scripts/build-overlays.ts && tsx scripts/build-api-overlays.ts",
    "build:api": "tsx scripts/build-api-overlays.ts",
    "predev": "tsx scripts/copy-sqlite-assets.ts && tsx scripts/build-overlays.ts && tsx scripts/build-api-overlays.ts",
    "dev": "next dev --port 3210",
    "prebuild": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsx scripts/copy-sqlite-assets.ts && tsx scripts/build-overlays.ts && tsx scripts/build-api-overlays.ts",
    "build": "next build",
    "serve": "node scripts/serve-out.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:overlays": "tsx scripts/check-overlays.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "marked": "^18.0.14",
    "minisearch": "^7.2.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js-httpvfs": "^0.8.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
